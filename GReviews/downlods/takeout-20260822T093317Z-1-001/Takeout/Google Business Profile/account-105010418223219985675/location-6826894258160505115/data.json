    "freeFormServiceItem": {
      "category": "categories/gcid:education_center",
      "label": {
        "displayName": "Jolly Phonics classes",
        "description": "Give your child the power of reading and writing with Jolly Phonics – a fun and effective way to build strong literacy skills! At Excel Kids Hub, we offer specialized Jolly Phonics Classes designed to help children develop a solid foundation in English through a structured, multi-sensory approach."
      }
    }
  }, {
    "freeFormServiceItem": {
      "category": "categories/gcid:education_center",
      "label": {
        "displayName": "Grammar Classes",
        "description": "At ExcelKidsHub, we make grammar easy and enjoyable with a structured and interactive learning approach. Our Grammar Classes are designed to help students build a strong foundation in English, improving their writing, speaking, and comprehension skills."
      }
    }
  }, {
    "freeFormServiceItem": {
      "category": "categories/gcid:education_center",
      "label": {
        "displayName": "Jolly Phonics Teacher Training and Certification",
        "description": "At ExcelKidsHub, we offer Jolly Phonics Training for teachers and parents, empowering them with effective phonics-based teaching methods to enhance children’s reading and writing skills. Our training comes with an ISO-certified certification, ensuring high-quality learning and global recognition."
      }
    }
